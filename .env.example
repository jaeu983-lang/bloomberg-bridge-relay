# Copy to .env. All remote paths stay disabled by default.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
GITHUB_ALLOWED_USERS=
GITHUB_COMMAND_LABEL=bridge-command
REMOTE_COMMANDS_ENABLED=false
REMOTE_SEARCHAGENT_SUBMIT_ENABLED=false
REMOTE_SEARCHAGENT_JOBS_ENABLED=false
REMOTE_SEARCHAGENT_REPOSITORY=jaeu983-lang/bloomberg-bridge-relay
REMOTE_SEARCHAGENT_LABEL=bridge-searchagent-job
REMOTE_SEARCHAGENT_ALLOWED_USERS=jaeu983-lang
REMOTE_SEARCHAGENT_SUBMIT_TOKEN=
REMOTE_SEARCHAGENT_WORKER_TOKEN=
REMOTE_SEARCHAGENT_WORKER_KEY_ID=worker-v1
REMOTE_SEARCHAGENT_SIGNER_KEY_ID=submitter-v1
REMOTE_SEARCHAGENT_WORKER_PUBLIC_KEY_PATH=
REMOTE_SEARCHAGENT_WORKER_PRIVATE_KEY_PATH=
REMOTE_SEARCHAGENT_SIGNING_PRIVATE_KEY_PATH=
REMOTE_SEARCHAGENT_SIGNING_PUBLIC_KEY_PATH=
BRIDGE_POLL_INTERVAL_SECONDS=60
BRIDGE_DB_PATH=data/bridge.sqlite3
SEARCHAGENT_PYTHON=
SEARCHAGENT_ROOT=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
